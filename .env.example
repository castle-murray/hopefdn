# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Leave DATABASE_URL unset to use embedded PGLite for local preview.
# Set it to use your Postgres instance (required for a durable deploy).

# ── Auth ──────────────────────────────────────────────────────────────────────
VITE_AUTH_ENABLED=true
BETTER_AUTH_SECRET=generate-a-long-random-string
# Optional fallback when request Host is missing. Prefer leaving this unset so
# Better Auth derives the origin from Host (supports hopefdn.org + exhibition).
# BETTER_AUTH_URL=https://hopefdn.org

# First superuser — created only when no admin exists yet
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=changeme
SUPERUSER_NAME=Superuser
SUPERUSER_EMAIL=admin@example.com

# Optional staff allowlist (comma-separated emails) — unused when roles are
# granted only via the superuser UI; kept for future use.
# STAFF_EMAILS=

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres (local or hosted). Example for this project's local DB:
# DATABASE_URL=postgres://hope:your-password@127.0.0.1:5432/hope
DATABASE_URL=

# ── Public hostnames / Vite HMR ───────────────────────────────────────────────
# Canonical host for OG tags (defaults to hopefdn.org).
VITE_PUBLIC_HOSTNAME=hopefdn.org
#
# Vite allowedHosts also includes hopefdn.org, www.hopefdn.org, and
# hope.castle-murray.com. Override/extend with a comma list if needed:
# VITE_ALLOWED_HOSTS=hopefdn.org,www.hopefdn.org,hope.castle-murray.com
#
# Dev HMR when viewing through a reverse proxy (not localhost). Point these at
# the host you are actually browsing:
# VITE_HMR_HOST=hopefdn.org
# VITE_HMR_PROTOCOL=wss
# VITE_HMR_CLIENT_PORT=443
# (plain HTTP proxy: protocol=ws, clientPort=80 or omit)

# ── SMTP (password-reset emails) ──────────────────────────────────────────────
# Until these are real, reset links are printed in the server console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="H.O.P.E. Foundation <noreply@example.com>"

# How long a reset link is valid (seconds). Default 3600 (1 hour).
# RESET_PASSWORD_TOKEN_EXPIRES_IN=3600
