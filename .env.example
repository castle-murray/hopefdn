# ── Auth ──────────────────────────────────────────────────────────────────────
# VITE_AUTH_ENABLED=true
# BETTER_AUTH_SECRET=generate-a-long-random-string
# BETTER_AUTH_URL=https://hope.castle-murray.com

# First superuser (created only when no admin exists yet)
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=changeme
SUPERUSER_NAME=Superuser
SUPERUSER_EMAIL=admin@example.com

# Optional staff allowlist (comma-separated emails) — unused when roles are
# granted only via superuser UI; kept for future use.
# STAFF_EMAILS=

# Postgres (production). Leave unset for local PGLite.
# DATABASE_URL=postgres://user:pass@host:5432/hope

# Public site hostname (OG tags + Vite HMR through reverse proxy)
# VITE_PUBLIC_HOSTNAME=hope.castle-murray.com
#
# Dev HMR when viewing via a reverse proxy (not localhost). Defaults to the
# public hostname above with ws://:80. For HTTPS proxy use:
# VITE_HMR_PROTOCOL=wss
# VITE_HMR_CLIENT_PORT=443
# Optional override if the public host differs from VITE_PUBLIC_HOSTNAME:
# VITE_HMR_HOST=hope.castle-murray.com

# ── SMTP (password reset emails) ──────────────────────────────────────────────
# Replace these dummy values with your real mail provider credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="H.O.P.E. Foundation <noreply@example.com>"

# How long a reset link is valid (seconds). Default 1 hour.
# RESET_PASSWORD_TOKEN_EXPIRES_IN=3600
